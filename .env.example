# Copy this file to .env and adjust values. Shell environment variables override it.
PORT=8080
# SQLITE_PATH=/absolute/path/to/your/database.sqlite
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Optional OpenAI-compatible provider. Keep your real key only in .env or your shell.
# LLM_PROVIDER=openai-compatible
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
